import streamlit as st
import pandas as pd

st.set_page_config(
    page_title="ZUO-AI",
    page_icon="✨",
    layout="wide"
)

st.title("✨ ZUO-AI")
st.subheader("Your AI-Powered Data Analyst")

st.write(
    "Turn your data into useful insights and smarter decisions."
)

uploaded_file = st.file_uploader(
    "Upload your CSV dataset",
    type=["csv"]
)

if uploaded_file is not None:
    df = pd.read_csv(uploaded_file)

    st.success("Dataset uploaded successfully!")

    st.subheader("📊 Dataset Preview")
    st.dataframe(df.head(10))

    st.subheader("📈 Data Summary")
    st.write(df.describe(include="all"))

    st.subheader("🔍 Missing Values")
    st.write(df.isnull().sum())

    st.subheader("📋 Dataset Information")
    st.write("Rows:", df.shape[0])
    st.write("Columns:", df.shape[1])

    st.subheader("❓ Ask a question about your data")
    question = st.text_input(
        "Example: How many rows are in my dataset?"
    )

    if question:
        if "row" in question.lower():
            st.write("Total rows:", df.shape[0])
        elif "column" in question.lower():
            st.write("Total columns:", df.shape[1])
        elif "missing" in question.lower():
            st.write(df.isnull().sum())
        else:
            st.write(
                "Try asking about rows, columns, or missing values."
            )
else:
    st.info("Upload a CSV file to start analyzing your data.")
